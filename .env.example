ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated emails allowed to generate editions (each one costs money)
ALLOWED_EMAILS=
# Set to 1 to use Claude Code on your Claude subscription instead of the API (local testing only)
USE_CLAUDE_CODE=
# Pictures (the front-page illustration and the comic strip): a key for OpenAI or Google. Optional: without one,
# the paper prints a placeholder box and the comic in words
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: pick a provider when both keys are set (openai or google), or override the model
IMAGE_PROVIDER=
IMAGE_MODEL=
# Birthdays from Google Calendar: the same Google OAuth client used for sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Automatic printing: a long random value that Vercel sends when it runs the daily scheduler
CRON_SECRET=
